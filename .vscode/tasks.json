{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && nvm use && npm run build",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-l",
            "-i",
            "-c"
          ]
        }
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build",
      "label": "tsc: build - tsconfig.json"
    }
  ]
}
