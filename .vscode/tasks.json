{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && nvm use >/dev/null && npm run compile",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-l",
            "-c"
          ]
        }
      },
      "problemMatcher": [],
      "group": "build",
      "label": "compile via nvm"
    }
  ]
}
