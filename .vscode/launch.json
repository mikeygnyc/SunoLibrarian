{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "download",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2",
        "-f",
        "wav"
      ],
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - List",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "list",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2"
      ],
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Workspaces",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "workspaces",
        "--token",
        "YOUR_TOKEN_HERE"
      ],
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Sync",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "sync",
        "-o",
        "/path/to/output/directory/",
        "--metadata-file",
        "/path/to/songs_metadata.json",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2",
        "--database-type",
        "postgres"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Import JSON",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "import-metadata-json",
        "--input",
        "/path/to/songs_metadata.json",
        "--database-type",
        "postgres"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Image List",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "download-images",
        "--list",
        "${workspaceFolder}/image_list.json",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2"
      ],
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Process",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "process",
        "-i",
        "${workspaceFolder}/downloads",
        "-o",
        "${workspaceFolder}/library",
        "--process-formats",
        "flac,mp3,alac,wav",
        "--exit-on-error",
        "--reconvert-missing"
      ],
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Capture Auth Token",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "capture-auth-token",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2"
      ],
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/api/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "3000",
        "--control-plane",
        "postgres",
        "--database-type",
        "postgres",
        "--output",
        "${workspaceFolder}/downloads",
        "--library",
        "${workspaceFolder}/library",
        "--log-file",
        "${workspaceFolder}/data/http-api.log"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Local Stack (Supervisor)",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/supervisor/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2",
        "--database-type",
        "postgres",
        "--control-plane",
        "postgres"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "autoAttachChildProcesses": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Orchestrator",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/orchestrator/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--control-plane",
        "postgres",
        "--poll-interval",
        "500"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Librarian",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/librarian/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--workspace",
        "YOUR_WORKSPACE_ID_HERE",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/chrome-user-data",
        "--profile-directory",
        "Profile 2",
        "--database-type",
        "postgres",
        "--librarian-interval",
        "300000"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Worker - Asset",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/worker/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--role",
        "asset",
        "--control-plane",
        "postgres",
        "--poll-interval",
        "500"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Worker - Processing",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/worker/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--role",
        "processing",
        "--control-plane",
        "postgres",
        "--poll-interval",
        "500"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [ 
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Worker - Conversion",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/worker/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--role",
        "conversion",
        "--control-plane",
        "postgres",
        "--poll-interval",
        "500"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Worker - Auth",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/worker/main.js",
      "cwd": "${workspaceFolder}",
      "args": [
        "--role",
        "auth",
        "--control-plane",
        "postgres",
        "--poll-interval",
        "500"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Supervisor (Bare)",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "runtimeVersion": "24",
      "program": "${workspaceFolder}/dist/apps/supervisor/main.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "autoAttachChildProcesses": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Split API Stack",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "configurations": [
        "Debug API",
        "Debug Orchestrator",
        "Debug Worker - Auth",
        "Debug Worker - Asset",
        "Debug Worker - Processing",
        "Debug Worker - Conversion"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Split API Stack + Librarian",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "configurations": [
        "Debug API",
        "Debug Orchestrator",
        "Debug Worker - Auth",
        "Debug Worker - Asset",
        "Debug Worker - Processing",
        "Debug Worker - Conversion",
        "Debug Librarian"
      ],
      "stopAll": true
    }
  ]
}
