{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "program": "${workspaceFolder}/cli/dist/index.js",
      "preLaunchTask": "tsc: build - cli/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/cli/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/cli",
      "args": [
        "download",
        "--browser",
        "http://localhost:9222",
        "-f",
        "wav"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - List",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "program": "${workspaceFolder}/cli/dist/index.js",
      "preLaunchTask": "tsc: build - cli/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/cli/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/cli",
      "args": [
        "list",
        "--token",
        "YOUR_TOKEN_HERE"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Workspaces",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "program": "${workspaceFolder}/cli/dist/index.js",
      "preLaunchTask": "tsc: build - cli/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/cli/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/cli",
      "args": [
        "workspaces",
        "--token",
        "YOUR_TOKEN_HERE"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Image List",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "program": "${workspaceFolder}/cli/dist/index.js",
      "preLaunchTask": "tsc: build - cli/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/cli/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/cli",
      "args": [
        "download-images",
        "--list",
        "${workspaceFolder}/image_list.json",
        "--browser",
        "http://localhost:9222"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Converter",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "program": "${workspaceFolder}/converter/dist/index.js",
      "preLaunchTask": "tsc: build - converter/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/converter/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/converter",
      "args": [
        "-i",
        "${workspaceFolder}/downloads",
        "-o",
        "${workspaceFolder}/library",
        "-f",
        "flac,mp3,alac,wav",
        "--exit-on-error",
        "--reconvert-missing"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Converter Image List",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "program": "${workspaceFolder}/converter/dist/index.js",
      "preLaunchTask": "tsc: build - converter/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/converter/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/converter",
      "args": [
        "-i",
        "${workspaceFolder}/downloads",
        "-o",
        "${workspaceFolder}/library",
        "--image-list",
        "${workspaceFolder}/image_list.json"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}