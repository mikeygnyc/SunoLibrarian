{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "runtimeArgs": [
        "node"
      ],
      "program": "${workspaceFolder}/dist/index.js",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "download",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/user/Library/Application Support/Google/Chrome",
        "-f",
        "wav"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - List",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "runtimeArgs": [
        "node"
      ],
      "program": "${workspaceFolder}/dist/index.js",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "list",
        "--browser",
        "http://localhost:9222",
        "--browser-profile",
        "/path/to/user/Library/Application Support/Google/Chrome",
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Workspaces",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "runtimeArgs": [
        "node"
      ],
      "program": "${workspaceFolder}/dist/index.js",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "workspaces",
        "--token",
        "YOUR_TOKEN_HERE"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI - Image List",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "runtimeArgs": [
        "node"
      ],
      "program": "${workspaceFolder}/dist/index.js",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "download-images",
        "--list",
        "${workspaceFolder}/image_list.json",
        "--browser",
        "http://localhost:9222"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Process",
      "runtimeExecutable": "${userHome}/.nvm/nvm-exec",
      "runtimeArgs": [
        "node"
      ],
      "program": "${workspaceFolder}/dist/index.js",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "args": [
        "process",
        "-i",
        "${workspaceFolder}/downloads",
        "-o",
        "${workspaceFolder}/library",
        "--process-formats",
        "flac,mp3,alac,wav",
        "--exit-on-error",
        "--reconvert-missing"
      ],
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
