# Copy to pre-conf-bootstrap-k8s-local.env and replace every value locally.
# This file is sourced by pre-conf-bootstrap-k8s-local.sh and must remain
# simple shell environment assignments.

RUNTIME_POSTGRES_URL='postgres://user:password@postgres.example.internal:5432/suno_export'
RUNTIME_MQTT_URL='mqtt://mqtt.example.internal:1883'

ELK_ELASTICSEARCH_HOSTS='https://elasticsearch.example.internal:9200'
ELK_ELASTICSEARCH_USERNAME='filebeat_suno_export'
ELK_ELASTICSEARCH_PASSWORD='replace-with-filebeat-password'
ELK_ELASTICSEARCH_ADMIN_USERNAME='elastic'
ELK_ELASTICSEARCH_ADMIN_PASSWORD='replace-with-admin-password'

# Optional: a PEM certificate may be provided as a multiline value.
# ELK_ELASTICSEARCH_CA_CERT='-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----'
ELK_ENVIRONMENT='local'
