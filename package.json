{
  "name": "suno-export",
  "version": "1.0.0",
  "description": "Unified Suno downloader and processor CLI",
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "man",
    "scripts",
    "README.md",
    "package.json"
  ],
  "bin": {
    "suno-export": "./bin/suno-export"
  },
  "scripts": {
    "build": "npm install && tsc -p tsconfig.json",
    "test": "node --test -r ts-node/register test/**/*.test.ts",
    "install:local": "scripts/install.sh",
    "install:global": "scripts/install-global.sh",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "postinstall": "node scripts/install-manpage.js",
    "preuninstall": "node scripts/uninstall-manpage.js"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "commander": "^11.1.0",
    "node-fetch": "^2.7.0",
    "puppeteer": "^24.37.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.5",
    "@types/node-fetch": "^2.6.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
