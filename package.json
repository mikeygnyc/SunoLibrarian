{
  "name": "suno-export",
  "version": "1.0.0",
  "description": "Unified Suno downloader and processor CLI",
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "man",
    "scripts",
    "README.md",
    "package.json"
  ],
  "bin": {
    "suno-export": "./bin/suno-export"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "npm install && tsc -p tsconfig.json",
    "build:api": "npm run build",
    "build:operator": "npm run build",
    "build:k8s-operator": "npm run build",
    "build:worker": "npm run build",
    "build:librarian": "npm run build",
    "test": "node --test -r ts-node/register test/**/*.test.ts",
    "install:local": "scripts/install.sh",
    "install:global": "scripts/install-global.sh",
    "start": "node dist/index.js",
    "start:api": "node dist/apps/api/main.js",
    "start:operator": "node dist/apps/operator-cli/main.js",
    "start:k8s-operator": "node dist/apps/k8s-operator/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "start:librarian": "node dist/apps/librarian/main.js",
    "dev": "ts-node src/index.ts",
    "dev:api": "ts-node src/apps/api/main.ts",
    "dev:operator": "ts-node src/apps/operator-cli/main.ts",
    "dev:k8s-operator": "ts-node src/apps/k8s-operator/main.ts",
    "dev:worker": "ts-node src/apps/worker/main.ts",
    "dev:librarian": "ts-node src/apps/librarian/main.ts",
    "postinstall": "node scripts/install-manpage.js",
    "preuninstall": "node scripts/uninstall-manpage.js"
  },
  "license": "MIT",
  "dependencies": {
    "@kubernetes/client-node": "^1.3.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^11.1.0",
    "human-id": "^4.1.3",
    "mqtt": "^5.14.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.20.0",
    "puppeteer": "^24.37.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.5",
    "@types/node-fetch": "^2.6.9",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
