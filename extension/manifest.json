{
   "action": {
      "default_icon": {
         "128": "icon128.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "content.css" ],
      "js": [ "jszip.min.js", "content.js" ],
      "matches": [ "https://suno.com/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "host_permissions": [ "https://suno.com/*", "https://studio-api.prod.suno.com/*", "https://cdn1.suno.ai/*", "https://cdn2.suno.ai/*" ],
   "icons": {
      "128": "icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Suno Tracks Exporter",
   "permissions": [ "storage", "downloads", "tabs", "webRequest" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.4",
   "web_accessible_resources": [ {
      "matches": [ "https://suno.com/*" ],
      "resources": [ "icon128.png" ]
   } ]
}
